# Blueprint Arcade environment variables
# Set these in Replit Secrets. For local use only, copy to a git-ignored .env.
# Leave this template empty; never commit real credentials.

# Database connection (Replit PostgreSQL provides this)
DATABASE_URL=

# Session secret (any long random string)
SESSION_SECRET=

# Required for QA demo seeding (8+ characters, at most 72 UTF-8 bytes)
SEED_PASSWORD=
